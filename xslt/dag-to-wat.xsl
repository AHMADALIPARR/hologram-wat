<?xml version="1.0" encoding="UTF-8"?>
<!--
  dag-to-wat.xsl — XSLT stylesheet transforming XML DAG DSL to pure WAT.
  SPDX-License-Identifier: AGPL-3.0-only

  Usage:
    xsltproc xslt/dag-to-wat.xsl dsl/module.xml > wat/module.wat
    # or: python3 tools/transform.py dsl/ wat/

  This stylesheet is the ONLY path from XML to WAT. No hand-written WAT.
  Every WAT instruction is generated from a DAG node. The transformation
  is deterministic: same XML in, same WAT out, byte for byte.
-->
<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:dag="http://hologram.dev/dag"
  xmlns="http://hologram.dev/dag"
  exclude-result-prefixes="dag">

  <xsl:output method="text" encoding="UTF-8" indent="no"/>
  <xsl:strip-space elements="*"/>

  <!-- Module -->
  <xsl:template match="/dag:module">
    <xsl:text>;; Generated by hologram-wat dag-to-wat.xsl&#10;</xsl:text>
    <xsl:text>;; Source: </xsl:text>
    <xsl:value-of select="@name"/>
    <xsl:text>&#10;</xsl:text>
    <xsl:text>;; DO NOT EDIT. Edit the XML DSL and re-run the transform.&#10;</xsl:text>
    <xsl:text>(module&#10;</xsl:text>
    <xsl:apply-templates select="dag:memory"/>
    <xsl:apply-templates select="dag:function"/>
    <xsl:text>)&#10;</xsl:text>
  </xsl:template>

  <!-- Memory -->
  <xsl:template match="dag:memory">
    <xsl:text>  (memory </xsl:text>
    <xsl:value-of select="@pages"/>
    <xsl:if test="@max">
      <xsl:text> </xsl:text>
      <xsl:value-of select="@max"/>
    </xsl:if>
    <xsl:text>)&#10;</xsl:text>
  </xsl:template>

  <!-- Function -->
  <xsl:template match="dag:function">
    <xsl:text>  (func $</xsl:text>
    <xsl:value-of select="@name"/>
    <xsl:if test="@export = 'true'">
      <xsl:text> (export "</xsl:text>
      <xsl:value-of select="@name"/>
      <xsl:text>")</xsl:text>
    </xsl:if>
    <xsl:text>&#10;</xsl:text>
    <xsl:apply-templates select="dag:param"/>
    <xsl:apply-templates select="dag:result"/>
    <xsl:apply-templates select="dag:local"/>
    <xsl:apply-templates select="dag:body"/>
    <xsl:text>  )&#10;</xsl:text>
  </xsl:template>

  <!-- Param -->
  <xsl:template match="dag:param">
    <xsl:text>    (param $</xsl:text>
    <xsl:value-of select="@name"/>
    <xsl:text> </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>)&#10;</xsl:text>
  </xsl:template>

  <!-- Result -->
  <xsl:template match="dag:result">
    <xsl:text>    (result </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>)&#10;</xsl:text>
  </xsl:template>

  <!-- Local -->
  <xsl:template match="dag:local">
    <xsl:text>    (local $</xsl:text>
    <xsl:value-of select="@name"/>
    <xsl:text> </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>)&#10;</xsl:text>
  </xsl:template>

  <!-- Body -->
  <xsl:template match="dag:body">
    <xsl:apply-templates/>
  </xsl:template>

  <!-- Const -->
  <xsl:template match="dag:const">
    <xsl:text>    </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>.const </xsl:text>
    <xsl:value-of select="@value"/>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>

  <!-- Local get -->
  <xsl:template match="dag:local.get">
    <xsl:text>    local.get $</xsl:text>
    <xsl:value-of select="@name"/>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>

  <!-- Local set -->
  <xsl:template match="dag:local.set">
    <xsl:apply-templates/>
    <xsl:text>    local.set $</xsl:text>
    <xsl:value-of select="@name"/>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>

  <!-- Call -->
  <xsl:template match="dag:call">
    <xsl:apply-templates/>
    <xsl:text>    call $</xsl:text>
    <xsl:value-of select="@func"/>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>

  <!-- Binary ops -->
  <xsl:template match="dag:add">
    <xsl:apply-templates/>
    <xsl:text>    </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>.add&#10;</xsl:text>
  </xsl:template>

  <xsl:template match="dag:sub">
    <xsl:apply-templates/>
    <xsl:text>    </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>.sub&#10;</xsl:text>
  </xsl:template>

  <xsl:template match="dag:mul">
    <xsl:apply-templates/>
    <xsl:text>    </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>.mul&#10;</xsl:text>
  </xsl:template>

  <xsl:template match="dag:div">
    <xsl:apply-templates/>
    <xsl:text>    </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>.div_s&#10;</xsl:text>
  </xsl:template>

  <!-- Load -->
  <xsl:template match="dag:load">
    <xsl:apply-templates/>
    <xsl:text>    </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>.load offset=</xsl:text>
    <xsl:choose>
      <xsl:when test="@offset"><xsl:value-of select="@offset"/></xsl:when>
      <xsl:otherwise>0</xsl:otherwise>
    </xsl:choose>
    <xsl:text> align=</xsl:text>
    <xsl:choose>
      <xsl:when test="@align"><xsl:value-of select="@align"/></xsl:when>
      <xsl:otherwise>4</xsl:otherwise>
    </xsl:choose>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>

  <!-- Store -->
  <xsl:template match="dag:store">
    <xsl:apply-templates/>
    <xsl:text>    </xsl:text>
    <xsl:value-of select="@type"/>
    <xsl:text>.store offset=</xsl:text>
    <xsl:choose>
      <xsl:when test="@offset"><xsl:value-of select="@offset"/></xsl:when>
      <xsl:otherwise>0</xsl:otherwise>
    </xsl:choose>
    <xsl:text> align=</xsl:text>
    <xsl:choose>
      <xsl:when test="@align"><xsl:value-of select="@align"/></xsl:when>
      <xsl:otherwise>4</xsl:otherwise>
    </xsl:choose>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>

  <!-- Block -->
  <xsl:template match="dag:block">
    <xsl:text>    block</xsl:text>
    <xsl:if test="@label">
      <xsl:text> $</xsl:text>
      <xsl:value-of select="@label"/>
    </xsl:if>
    <xsl:text>&#10;</xsl:text>
    <xsl:apply-templates/>
    <xsl:text>    end&#10;</xsl:text>
  </xsl:template>

  <!-- Loop -->
  <xsl:template match="dag:loop">
    <xsl:text>    loop</xsl:text>
    <xsl:if test="@label">
      <xsl:text> $</xsl:text>
      <xsl:value-of select="@label"/>
    </xsl:if>
    <xsl:text>&#10;</xsl:text>
    <xsl:apply-templates/>
    <xsl:text>    end&#10;</xsl:text>
  </xsl:template>

  <!-- If -->
  <xsl:template match="dag:if">
    <xsl:apply-templates select="dag:condition"/>
    <xsl:text>    if&#10;</xsl:text>
    <xsl:apply-templates select="dag:then"/>
    <xsl:if test="dag:else">
      <xsl:text>    else&#10;</xsl:text>
      <xsl:apply-templates select="dag:else"/>
    </xsl:if>
    <xsl:text>    end&#10;</xsl:text>
  </xsl:template>

  <!-- Branch -->
  <xsl:template match="dag:br">
    <xsl:text>    br $</xsl:text>
    <xsl:value-of select="@label"/>
    <xsl:text>&#10;</xsl:text>
  </xsl:template>

  <!-- Return -->
  <xsl:template match="dag:return">
    <xsl:apply-templates/>
    <xsl:text>    return&#10;</xsl:text>
  </xsl:template>

  <!-- Drop -->
  <xsl:template match="dag:drop">
    <xsl:apply-templates/>
    <xsl:text>    drop&#10;</xsl:text>
  </xsl:template>

</xsl:stylesheet>
