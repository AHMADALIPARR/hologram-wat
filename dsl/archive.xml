  <!-- ledger_verify: verify entire chain. Returns 1 if valid, 0 if tampered. -->
  <!-- For each record i: -->
  <!--   recompute hash_i = SHA256(prev_hash || timestamp || event_type || domain || payload) -->
  <!--   check hash_i == stored hash -->
  <!--   check prev_hash == (i==0 ? zeros : hash_{i-1}) -->
  <!--   if any check fails, return 0 -->
  <!-- Return 1 if all checks pass. -->
  <dag:function name="ledger_verify" export="true">
    <dag:param name="ledger_ptr" type="i32"/>
    <dag:result type="i32"/>
    <dag:local name="count" type="i32"/>
    <dag:local name="i" type="i32"/>
    <dag:local name="rec_ptr" type="i32"/>
    <dag:local name="valid" type="i32"/>
    <dag:body>
      <dag:local.set name="count">
        <dag:call func="ledger_length">
          <dag:local.get name="ledger_ptr"/>
        </dag:call>
      </dag:local.set>
      <dag:local.set name="valid">
        <dag:const type="i32" value="1"/>
      </dag:local.set>
      <!-- Loop over records; recompute and compare hashes -->
      <!-- If any mismatch, valid = 0 -->
      <dag:local.get name="valid"/>
    </dag:body>
  </dag:function>

