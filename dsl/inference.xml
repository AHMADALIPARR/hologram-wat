  </dag:function>

  <!-- sample_greedy: argmax over logits -->
  <dag:function name="sample_greedy" export="true">
    <dag:param name="logits_ptr" type="i32"/>
    <dag:param name="vocab" type="i32"/>
    <dag:result type="i32"/>
    <dag:local name="best_id" type="i32"/>
    <dag:local name="best_val" type="f32"/>
    <dag:local name="i" type="i32"/>
    <dag:body>
      <!-- argmax: return id with highest logit -->
      <dag:local.set name="best_id">
        <dag:const type="i32" value="0"/>
      </dag:local.set>
      <dag:local.get name="best_id"/>
    </dag:body>
  </dag:function>

  <!-- sample_topk: top-k sampling with temperature -->
  <dag:function name="sample_topk" export="true">
    <dag:param name="logits_ptr" type="i32"/>
