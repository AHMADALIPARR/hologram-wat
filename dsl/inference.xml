    </dag:body>
  </dag:function>

  <!-- swiglu: SwiGLU MLP — down(silu(gate) * up) -->
  <dag:function name="swiglu" export="true">
    <dag:param name="x_ptr" type="i32"/>
    <dag:param name="gate_ptr" type="i32"/>
