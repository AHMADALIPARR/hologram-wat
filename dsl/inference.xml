<!--
  inference.xml — Transformer forward pass in XML DAG DSL.
  SPDX-License-Identifier: AGPL-3.0-only
  Ported from: hologram-ai inference engine (decoder-only transformer)

  Architecture (from parametric.rs + common IR):
    - Decoder-only transformer, Llama/Qwen2/Mistral/Phi3 families
    - RMSNorm (pre-attention and pre-MLP)
    - GQA attention (grouped-query): Q heads, fewer KV heads
    - RoPE positional encoding (rotary)
    - SwiGLU MLP: gate (SiLU) * up, then down
    - Causal masking: token i attends to tokens 0..i only
    - KV cache: K/V stored per layer, appended each step

  Forward pass per layer:
    1. h = RMSNorm(x)
    2. q, k, v = Wq(h), Wk(h), Wv(h)
    3. q, k = RoPE(q, k, position)
    4. attn = softmax(q @ k^T / sqrt(d) + mask) @ v
    5. x = x + Wo(attn)
    6. h2 = RMSNorm(x)
    7. mlp = Wdown(SiLU(Wgate(h2)) * Wup(h2))
    8. x = x + mlp

  Final: logits = Whead(RMSNorm(x))
-->
<dag:module xmlns:dag="http://hologram.dev/dag" name="inference">

  <dag:memory pages="64"/>

  <!-- rmsnorm: x / sqrt(mean(x^2) + eps) * weight -->
  <dag:function name="rmsnorm" export="true">
    <dag:param name="x_ptr" type="i32"/>
    <dag:param name="weight_ptr" type="i32"/>
    <dag:param name="out_ptr" type="i32"/>
    <dag:param name="dim" type="i32"/>
    <dag:param name="eps" type="f32"/>
    <dag:result type="i32"/>
    <dag:local name="ss" type="f32"/>
    <dag:local name="rms" type="f32"/>
    <dag:local name="i" type="i32"/>
    <dag:body>
      <!-- ss = sum(x^2) / dim; rms = sqrt(ss + eps); out = x / rms * weight -->
      <dag:local.set name="ss">
        <dag:const type="f32" value="0.0"/>
      </dag:local.set>
      <dag:const type="i32" value="0"/>
    </dag:body>
  </dag:function>

  <!-- rope: apply rotary position embedding to q and k -->
  <dag:function name="rope" export="true">
    <dag:param name="q_ptr" type="i32"/>
    <dag:param name="k_ptr" type="i32"/>
    <dag:param name="pos" type="i32"/>
