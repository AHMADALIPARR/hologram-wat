    <dag:param name="theta" type="f32"/>
    <dag:result type="i32"/>
    <dag:local name="i" type="i32"/>
    <dag:local name="freq" type="f32"/>
    <dag:local name="angle" type="f32"/>
    <dag:body>
      <!-- For each pair (x0, x1) at positions (2i, 2i+1): -->
      <!--   freq = 1 / theta^(2i / head_dim) -->
      <!--   angle = pos * freq -->
      <!--   (x0', x1') = (x0*cos - x1*sin, x0*sin + x1*cos) -->
      <dag:const type="i32" value="0"/>
    </dag:body>
  </dag:function>

  <!-- attention: scaled dot-product attention with causal mask -->
