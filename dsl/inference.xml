    </dag:body>
  </dag:function>

  <!-- forward: full model forward pass -->
  <dag:function name="forward" export="true">
    <dag:param name="tokens_ptr" type="i32"/>
    <dag:param name="n_tokens" type="i32"/>
    <dag:param name="weights_ptr" type="i32"/>
    <dag:param name="kv_cache_ptr" type="i32"/>
    <dag:param name="logits_ptr" type="i32"/>
    <dag:param name="n_layers" type="i32"/>
    <dag:param name="hidden" type="i32"/>
