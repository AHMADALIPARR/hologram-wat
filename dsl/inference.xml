    <dag:param name="q_ptr" type="i32"/>
    <dag:param name="k_ptr" type="i32"/>
    <dag:param name="v_ptr" type="i32"/>
    <dag:param name="out_ptr" type="i32"/>
    <dag:param name="seq_len" type="i32"/>
    <dag:param name="head_dim" type="i32"/>
    <dag:param name="n_heads" type="i32"/>
    <dag:param name="n_kv_heads" type="i32"/>
    <dag:result type="i32"/>
    <dag:local name="scale" type="f32"/>
    <dag:local name="h" type="i32"/>
    <dag:local name="i" type="i32"/>
    <dag:local name="j" type="i32"/>
    <dag:body>
      <!-- scale = 1 / sqrt(head_dim) -->
      <!-- For each head h, each query position i: -->
      <!--   scores[j] = (q[i] . k[j]) * scale for j <= i (causal) -->
