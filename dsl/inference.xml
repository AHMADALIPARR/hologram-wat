    <dag:param name="weights_ptr" type="i32"/>
    <dag:param name="kv_cache_ptr" type="i32"/>
    <dag:param name="pos" type="i32"/>
    <dag:param name="hidden" type="i32"/>
    <dag:param name="n_heads" type="i32"/>
    <dag:param name="n_kv_heads" type="i32"/>
    <dag:param name="intermediate" type="i32"/>
    <dag:result type="i32"/>
