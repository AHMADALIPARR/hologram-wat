    <dag:param name="out_ptr" type="i32"/>
    <dag:param name="hidden" type="i32"/>
    <dag:param name="intermediate" type="i32"/>
    <dag:result type="i32"/>
    <dag:local name="i" type="i32"/>
    <dag:local name="gate_val" type="f32"/>
    <dag:local name="up_val" type="f32"/>
    <dag:body>
