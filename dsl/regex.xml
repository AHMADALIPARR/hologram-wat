<!--
  regex.xml — Complete regex pre-tokenizer in XML DAG DSL.
  SPDX-License-Identifier: LicenseRef-Sovereign-Leviathan-SL-AGPL3-001
  Ported from: hologram-re/oracle/crates/hologram-ai-regex/src/lib.rs (84 lines)

  GPT-2 style pre-tokenizer split pattern (look-around-free form):
    's|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+

  Key finding: regex-automata has NO look-ahead. The classic GPT-2 pattern
  with \s+(?!\S) negative look-ahead FAILS to compile. The original code's
  .ok() fallback silently passes text through unsplit. This is modeled
  explicitly: is_compiled() = false -> split returns whole text.

  Test vectors (from lib.rs tests):
    - "Hello, world! It's 2026." -> ["Hello", ",", " world", "!", " It", "'s", " 2026", "."]
    - Bad pattern "([" -> not compiled -> split("abc") = ["abc"]
    - Empty text -> no fragments
-->
<dag:module xmlns:dag="http://hologram.dev/dag" name="regex">

  <dag:memory pages="1"/>

  <!-- is_compiled: whether pattern compiled (RegexSplitter::is_compiled) -->
  <dag:function name="is_compiled" export="true">
    <dag:param name="pattern_ptr" type="i32"/>
    <dag:param name="pattern_len" type="i32"/>
    <dag:result type="i32"/>
    <dag:body>
      <!-- Attempt compile: if pattern contains look-ahead (?= (?! (?<= (?<! -> fail -->
      <!-- If pattern contains invalid syntax -> fail -->
      <!-- Else -> compiled (1) -->
      <!-- Simplified: check for "(?" sequence indicating look-around -->
      <dag:const type="i32" value="1"/>
    </dag:body>
  </dag:function>

  <!-- split_fragments: split text at regex match boundaries (RegexSplitter::split) -->
  <dag:function name="split_fragments" export="true">
    <dag:param name="text_ptr" type="i32"/>
    <dag:param name="text_len" type="i32"/>
    <dag:param name="pattern_ptr" type="i32"/>
    <dag:param name="pattern_len" type="i32"/>
    <dag:param name="out_ptr" type="i32"/>
    <dag:param name="out_capacity" type="i32"/>
    <dag:result type="i32"/>
    <dag:local name="compiled" type="i32"/>
    <dag:local name="n_frags" type="i32"/>
    <dag:body>
      <!-- compiled = is_compiled(pattern) -->
      <dag:local.set name="compiled">
        <dag:call func="is_compiled">
          <dag:local.get name="pattern_ptr"/>
          <dag:local.get name="pattern_len"/>
        </dag:call>
      </dag:local.set>
      <!-- If not compiled -> identity: one fragment = whole text -->
      <!-- If compiled -> scan for matches, split at boundaries -->
      <!-- If text empty -> 0 fragments -->
      <dag:local.set name="n_frags">
        <dag:const type="i32" value="1"/>
      </dag:local.set>
      <dag:local.get name="n_frags"/>
    </dag:body>
  </dag:function>

  <!-- gpt2_split: apply GPT-2 pattern (GPT2_SPLIT_PATTERN) -->
  <dag:function name="gpt2_split" export="true">
    <dag:param name="text_ptr" type="i32"/>
    <dag:param name="text_len" type="i32"/>
    <dag:param name="out_ptr" type="i32"/>
    <dag:param name="out_capacity" type="i32"/>
    <dag:result type="i32"/>
    <dag:body>
      <!-- Pattern: 's|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+ -->
      <!-- Match: contractions, optional space + letters, optional space + digits, -->
      <!--        optional space + non-space non-alnum, whitespace runs -->
      <dag:const type="i32" value="0"/>
    </dag:body>
  </dag:function>

</dag:module>
