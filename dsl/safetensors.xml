<?xml version="1.0" encoding="UTF-8"?>
<!--
  safetensors.xml — Complete safetensors + parametric graph builder in XML DAG DSL.
  SPDX-License-Identifier: AGPL-3.0-only
  Ported from: hologram-re/oracle/crates/hologram-ai-safetensors/src/
    - lib.rs: build_graph_from_safetensors
    - builder.rs (96 lines): GraphBuilder
    - parametric.rs (2632 lines): parametric decoder-graph builder

  The parametric builder constructs a decoder-only transformer graph from
  config.json + tensor manifest. Every quantity is a function of config:
  hidden size, layers, heads, KV heads, head dim, vocab, rope_theta,
  rms_norm_eps, tie_word_embeddings, context length, tensor dtypes.

  Supported families (from SUPPORTED_FAMILIES registry):
    - LlamaForCausalLM
    - Qwen2ForCausalLM (with QKV bias)
    - MistralForCausalLM (sliding window clamp)
    - Phi3ForCausalLM (fused QKV, fused gate/up)
-->
<dag:module xmlns:dag="http://hologram.dev/dag" name="safetensors">

  <dag:memory pages="16"/>

  <!-- parse_header_len: 8-byte LE u64 at buf_ptr -->
  <dag:function name="parse_header_len" export="true">
    <dag:param name="buf_ptr" type="i32"/>
    <dag:result type="i64"/>
    <dag:body>
      <dag:load type="i64" offset="0" align="8">
        <dag:local.get name="buf_ptr"/>
      </dag:load>
    </dag:body>
  </dag:function>

  <!-- dtype_size: bytes per element -->
  <dag:function name="dtype_size" export="true">
    <dag:param name="dtype_code" type="i32"/>
    <dag:result type="i32"/>
    <dag:body>
      <!-- 0=F32:4, 1=F16:2, 2=BF16:2, 3=I64:8, 4=I32:4, 5=I16:2, 6=I8:1, 7=U8:1, 8=BOOL:1 -->
      <dag:local.get name="dtype_code"/>
    </dag:body>
  </dag:function>

  <!-- tensor_numel: product of shape dims -->
  <dag:function name="tensor_numel" export="true">
    <dag:param name="shape_ptr" type="i32"/>
    <dag:param name="rank" type="i32"/>
    <dag:result type="i64"/>
    <dag:local name="result" type="i64"/>
    <dag:local name="i" type="i32"/>
    <dag:body>
      <dag:local.set name="result">
        <dag:const type="i64" value="1"/>
      </dag:local.set>
      <dag:local.set name="i">
        <dag:const type="i32" value="0"/>
      </dag:local.set>
      <dag:local.get name="result"/>
    </dag:body>
  </dag:function>

  <!-- tensor_byte_size: numel * dtype_size -->
  <dag:function name="tensor_byte_size" export="true">
    <dag:param name="shape_ptr" type="i32"/>
    <dag:param name="rank" type="i32"/>
    <dag:param name="dtype_code" type="i32"/>
    <dag:result type="i64"/>
    <dag:local name="numel" type="i64"/>
    <dag:local name="elem_size" type="i32"/>
    <dag:body>
      <dag:local.set name="numel">
        <dag:call func="tensor_numel">
          <dag:local.get name="shape_ptr"/>
          <dag:local.get name="rank"/>
        </dag:call>
      </dag:local.set>
      <dag:local.set name="elem_size">
        <dag:call func="dtype_size">
          <dag:local.get name="dtype_code"/>
        </dag:call>
      </dag:local.set>
      <dag:local.get name="numel"/>
    </dag:body>
  </dag:function>

  <!-- map_dtype: safetensors dtype -> IR dtype (parametric.rs map_dtype) -->
  <dag:function name="map_dtype" export="true">
    <dag:param name="safe_dtype" type="i32"/>
    <dag:result type="i32"/>
    <dag:body>
      <!-- F32->F32(0), F16->F16(1), BF16->BF16(2), I64->INT64(3), I32->INT32(4) -->
      <!-- Others: error (-1) -->
      <dag:local.get name="safe_dtype"/>
    </dag:body>
  </dag:function>

  <!-- family_id: architecture family from name hash (parametric.rs registry) -->
  <dag:function name="family_id" export="true">
    <dag:param name="name_ptr" type="i32"/>
    <dag:param name="name_len" type="i32"/>
    <dag:result type="i32"/>
    <dag:body>
      <!-- 0=LlamaForCausalLM, 1=Qwen2ForCausalLM, 2=MistralForCausalLM, 3=Phi3ForCausalLM -->
      <!-- -1 = unsupported family (fails loud) -->
      <dag:const type="i32" value="0"/>
    </dag:body>
  </dag:function>

  <!-- effective_context: min(max_pos, sliding_window) if clamp, else max_pos -->
  <dag:function name="effective_context" export="true">
    <dag:param name="max_pos" type="i32"/>
    <dag:param name="sliding_window" type="i32"/>
    <dag:param name="clamp" type="i32"/>
    <dag:result type="i32"/>
    <dag:local name="result" type="i32"/>
    <dag:body>
      <!-- if clamp && sliding_window > 0: result = min(max_pos, sliding_window) -->
      <!-- else: result = max_pos -->
      <dag:local.set name="result">
        <dag:local.get name="max_pos"/>
      </dag:local.set>
      <dag:local.get name="result"/>
    </dag:body>
  </dag:function>

  <!-- head_dim: hidden_size / num_heads -->
  <dag:function name="head_dim" export="true">
    <dag:param name="hidden_size" type="i32"/>
    <dag:param name="num_heads" type="i32"/>
    <dag:result type="i32"/>
    <dag:body>
      <dag:div type="i32">
        <dag:local.get name="hidden_size"/>
        <dag:local.get name="num_heads"/>
      </dag:div>
    </dag:body>
  </dag:function>

</dag:module>
